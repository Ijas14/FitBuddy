# Google Gemini API Key
# Obtain from Google AI Studio: https://aistudio.google.com/
GOOGLE_API_KEY=your_gemini_api_key_here

# Gemini Model Names
# The spec DOCX names gemini-1.5-pro / gemini-1.5-flash. Google has retired both,
# so those names now return 404 and every call silently falls back to the
# offline engine. Use the current names below, which keep the spec's split of
# Pro for workout plans and Flash for nutrition tips.
# Free-tier keys have no Pro quota, so plans fall back until billing is enabled;
# nutrition tips work live on the free tier.
GEMINI_PRO_MODEL=gemini-3.1-pro-preview
GEMINI_FLASH_MODEL=gemini-3.5-flash

# SQLite Database URL
DATABASE_URL=sqlite:///./fitbuddy.db
